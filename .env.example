# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=111111111,222222222
# ID группы (супергруппы с темами). Можно оставить пустым — бот будет работать в любой группе
GROUP_ID=-1001234567890
# Время ежедневного отчёта админам (ЧЧ:ММ) и часовой пояс
DAILY_REPORT_TIME=20:00
TIMEZONE=Asia/Tashkent
# За сколько часов до дедлайна напоминать о несданных заданиях
REMIND_BEFORE_HOURS=24
# Сколько минут ждать фото-исправление, прежде чем вернуть кнопку другим
PHOTO_FIX_TIMEOUT_MIN=60
# Путь к базе данных SQLite
DB_PATH=data/bot.db
